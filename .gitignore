# Hexo
.DS_Store
Thumbs.db
db.json
*.log
node_modules/
# 《自然培育所》单文件构建产物（约 19MB，可由 tools/build_single.py 重建，不必进版本库）
source/自然培育所/dist/
# 只忽略根目录的 Hexo 构建产物（原来是 public/，会匹配任意层级的 public 目录）
/public/
.deploy_git/
.github/
.idea/
.vscode/
*.swp

# 系统与临时
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# 本机备份与工具目录（不进源码仓库）
.deploy_git_backup_*/
.playwright-cli/
_config - 副本.yml
_config.yml.bak-*
themes/shiro/git-meta-bak/

# 源目录里的手工副本（不参与构建）
source/forest - 副本/
source/bike - 副本/
source/guardian - 副本/

# forest 的本地工作区（工具目录 + 按时间戳的备份快照，加起来上百 MB，绝不入库）
source/forest/.dumate/
source/forest/_tmp/

# 例外：亲子知识擂台工程的 public/ 是前端源码（不是 Hexo 构建产物）
# 根目录的 public/ 规则会一并忽略它，导致这 3000+ 行前端代码进不了版本库
!source/parent-child-knowledge-game/public/
!source/parent-child-knowledge-game/public/**

# wrangler 本地缓存与构建产物（Cloudflare 部署用）
.wrangler/
cloudflare/room-worker/tmp/

# 运维手册（含管理员口令、账号 ID、Cloudflare 绑定的完整清单）
# ⚠️ 本仓库是公开仓库，推送即全网可见。手册只留本地，绝不入库。
/docs/

# 地球仪拼图：天地图官方原始边界（可用 --fetch / fetch_regions.py 重建，不入库）
source/globe-puzzle/data/*.geojson
source/globe-puzzle/data/raw/

# 本地测试产物
tmp/

# 本地备份文件
*.bak

# 本机协作/记忆缓存（只留本地，不进公开仓库）
/.cowork-temp/
/.workbuddy/
**/.dumate/
**/.workbuddy/

# 《人体积木》开发包：仓库只保留线上运行时 + 源码，中间产物不入库。
# 与线上构建无关且体积巨大：原始解剖数据集(152MB)、AI 3D 任务(含 token.txt 凭据)、
# 审阅截图/样片(329MB)、测试模型、可重建的单文件版(18MB)。
# ⚠️ assets/source/ai/ai-jobs/token.txt 是第三方平台令牌，公开仓库严禁入库。
source/human-body-bricks/assets/source/
source/human-body-bricks/assets/test-hq.glb
source/human-body-bricks/review/
source/human-body-bricks/人体积木.html
