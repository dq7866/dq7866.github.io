{
 "subject": "语文",
 "poems": [
  {
   "g": 1,
   "t": "咏鹅",
   "a": "骆宾王",
   "d": "唐",
   "theme": "动物",
   "l": [
    "鹅，鹅，鹅，曲项向天歌。",
    "白毛浮绿水，红掌拨清波。"
   ]
  },
  {
   "g": 1,
   "t": "静夜思",
   "a": "李白",
   "d": "唐",
   "theme": "思乡",
   "l": [
    "床前明月光，疑是地上霜。",
    "举头望明月，低头思故乡。"
   ]
  },
  {
   "g": 1,
   "t": "春晓",
   "a": "孟浩然",
   "d": "唐",
   "theme": "春天",
   "l": [
    "春眠不觉晓，处处闻啼鸟。",
    "夜来风雨声，花落知多少。"
   ]
  },
  {
   "g": 1,
   "t": "悯农",
   "a": "李绅",
   "d": "唐",
   "theme": "劳动",
   "l": [
    "锄禾日当午，汗滴禾下土。",
    "谁知盘中餐，粒粒皆辛苦。"
   ]
  },
  {
   "g": 2,
   "t": "登鹳雀楼",
   "a": "王之涣",
   "d": "唐",
   "theme": "立志",
   "l": [
    "白日依山尽，黄河入海流。",
    "欲穷千里目，更上一层楼。"
   ]
  },
  {
   "g": 2,
   "t": "咏柳",
   "a": "贺知章",
   "d": "唐",
   "theme": "春天",
   "l": [
    "碧玉妆成一树高，万条垂下绿丝绦。",
    "不知细叶谁裁出，二月春风似剪刀。"
   ]
  },
  {
   "g": 2,
   "t": "村居",
   "a": "高鼎",
   "d": "清",
   "theme": "春天",
   "l": [
    "草长莺飞二月天，拂堤杨柳醉春烟。",
    "儿童散学归来早，忙趁东风放纸鸢。"
   ]
  },
  {
   "g": 2,
   "t": "赋得古原草送别",
   "a": "白居易",
   "d": "唐",
   "theme": "送别",
   "l": [
    "离离原上草，一岁一枯荣。",
    "野火烧不尽，春风吹又生。"
   ]
  },
  {
   "g": 3,
   "t": "绝句",
   "a": "杜甫",
   "d": "唐",
   "theme": "春天",
   "l": [
    "两个黄鹂鸣翠柳，一行白鹭上青天。",
    "窗含西岭千秋雪，门泊东吴万里船。"
   ]
  },
  {
   "g": 3,
   "t": "望庐山瀑布",
   "a": "李白",
   "d": "唐",
   "theme": "山水",
   "l": [
    "日照香炉生紫烟，遥看瀑布挂前川。",
    "飞流直下三千尺，疑是银河落九天。"
   ]
  },
  {
   "g": 3,
   "t": "山行",
   "a": "杜牧",
   "d": "唐",
   "theme": "秋天",
   "l": [
    "远上寒山石径斜，白云生处有人家。",
    "停车坐爱枫林晚，霜叶红于二月花。"
   ]
  },
  {
   "g": 3,
   "t": "赠刘景文",
   "a": "苏轼",
   "d": "宋",
   "theme": "秋天",
   "l": [
    "荷尽已无擎雨盖，菊残犹有傲霜枝。",
    "一年好景君须记，最是橙黄橘绿时。"
   ]
  },
  {
   "g": 3,
   "t": "九月九日忆山东兄弟",
   "a": "王维",
   "d": "唐",
   "theme": "思乡",
   "l": [
    "独在异乡为异客，每逢佳节倍思亲。",
    "遥知兄弟登高处，遍插茱萸少一人。"
   ]
  },
  {
   "g": 3,
   "t": "望天门山",
   "a": "李白",
   "d": "唐",
   "theme": "山水",
   "l": [
    "天门中断楚江开，碧水东流至此回。",
    "两岸青山相对出，孤帆一片日边来。"
   ]
  },
  {
   "g": 4,
   "t": "题西林壁",
   "a": "苏轼",
   "d": "宋",
   "theme": "哲理",
   "l": [
    "横看成岭侧成峰，远近高低各不同。",
    "不识庐山真面目，只缘身在此山中。"
   ]
  },
  {
   "g": 4,
   "t": "游山西村",
   "a": "陆游",
   "d": "宋",
   "theme": "哲理",
   "l": [
    "山重水复疑无路，柳暗花明又一村。",
    "箫鼓追随春社近，衣冠简朴古风存。"
   ]
  },
  {
   "g": 4,
   "t": "黄鹤楼送孟浩然之广陵",
   "a": "李白",
   "d": "唐",
   "theme": "送别",
   "l": [
    "故人西辞黄鹤楼，烟花三月下扬州。",
    "孤帆远影碧空尽，唯见长江天际流。"
   ]
  },
  {
   "g": 4,
   "t": "送元二使安西",
   "a": "王维",
   "d": "唐",
   "theme": "送别",
   "l": [
    "渭城朝雨浥轻尘，客舍青青柳色新。",
    "劝君更尽一杯酒，西出阳关无故人。"
   ]
  },
  {
   "g": 4,
   "t": "江雪",
   "a": "柳宗元",
   "d": "唐",
   "theme": "冬天",
   "l": [
    "千山鸟飞绝，万径人踪灭。",
    "孤舟蓑笠翁，独钓寒江雪。"
   ]
  },
  {
   "g": 4,
   "t": "枫桥夜泊",
   "a": "张继",
   "d": "唐",
   "theme": "秋夜",
   "l": [
    "月落乌啼霜满天，江枫渔火对愁眠。",
    "姑苏城外寒山寺，夜半钟声到客船。"
   ]
  },
  {
   "g": 5,
   "t": "泊船瓜洲",
   "a": "王安石",
   "d": "宋",
   "theme": "思乡",
   "l": [
    "京口瓜洲一水间，钟山只隔数重山。",
    "春风又绿江南岸，明月何时照我还。"
   ]
  },
  {
   "g": 5,
   "t": "秋思",
   "a": "张籍",
   "d": "唐",
   "theme": "思乡",
   "l": [
    "洛阳城里见秋风，欲作家书意万重。",
    "复恐匆匆说不尽，行人临发又开封。"
   ]
  },
  {
   "g": 5,
   "t": "长相思",
   "a": "纳兰性德",
   "d": "清",
   "theme": "思乡",
   "l": [
    "山一程，水一程，身向榆关那畔行，夜深千帐灯。",
    "风一更，雪一更，聒碎乡心梦不成，故园无此声。"
   ]
  },
  {
   "g": 5,
   "t": "己亥杂诗",
   "a": "龚自珍",
   "d": "清",
   "theme": "立志",
   "l": [
    "九州生气恃风雷，万马齐喑究可哀。",
    "我劝天公重抖擞，不拘一格降人才。"
   ]
  },
  {
   "g": 5,
   "t": "示儿",
   "a": "陆游",
   "d": "宋",
   "theme": "爱国",
   "l": [
    "死去元知万事空，但悲不见九州同。",
    "王师北定中原日，家祭无忘告乃翁。"
   ]
  },
  {
   "g": 5,
   "t": "石灰吟",
   "a": "于谦",
   "d": "明",
   "theme": "品格",
   "l": [
    "千锤万凿出深山，烈火焚烧若等闲。",
    "粉骨碎身浑不怕，要留清白在人间。"
   ]
  },
  {
   "g": 6,
   "t": "竹石",
   "a": "郑燮",
   "d": "清",
   "theme": "品格",
   "l": [
    "咬定青山不放松，立根原在破岩中。",
    "千磨万击还坚劲，任尔东西南北风。"
   ]
  },
  {
   "g": 6,
   "t": "春夜喜雨",
   "a": "杜甫",
   "d": "唐",
   "theme": "春天",
   "l": [
    "好雨知时节，当春乃发生。",
    "随风潜入夜，润物细无声。"
   ]
  },
  {
   "g": 6,
   "t": "闻官军收河南河北",
   "a": "杜甫",
   "d": "唐",
   "theme": "爱国",
   "l": [
    "剑外忽传收蓟北，初闻涕泪满衣裳。",
    "却看妻子愁何在，漫卷诗书喜欲狂。"
   ]
  },
  {
   "g": 6,
   "t": "过零丁洋",
   "a": "文天祥",
   "d": "宋",
   "theme": "爱国",
   "l": [
    "辛苦遭逢起一经，干戈寥落四周星。",
    "人生自古谁无死，留取丹心照汗青。"
   ]
  },
  {
   "g": 6,
   "t": "长歌行",
   "a": "汉乐府",
   "d": "汉",
   "theme": "惜时",
   "l": [
    "百川东到海，何时复西归？",
    "少壮不努力，老大徒伤悲。"
   ]
  },
  {
   "g": 6,
   "t": "七步诗",
   "a": "曹植",
   "d": "三国",
   "theme": "亲情",
   "l": [
    "煮豆持作羹，漉菽以为汁。",
    "本是同根生，相煎何太急？"
   ]
  }
 ],
